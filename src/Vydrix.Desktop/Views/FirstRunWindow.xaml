<Window x:Class="Vydrix.Desktop.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to VYDRIX" Width="660" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/vydrix.ico">
    <StackPanel Margin="28,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Border Width="38" Height="38" CornerRadius="9" Background="#0A0F1E" BorderBrush="{StaticResource Accent}" BorderThickness="1" ClipToBounds="True" Margin="0,0,12,0">
                <Image Source="pack://application:,,,/Assets/vydrix_32.png" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="SemiBold"><Run Text="Welcome to VYD" /><Run Text="RIX" Foreground="{StaticResource Purple}" /></TextBlock>
                <TextBlock Text="CLOUD-TO-SSD ENGINE" FontSize="10" Foreground="{StaticResource Dim}" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,18"
                   Text="VYDRIX keeps your games in cloud storage and runs them on this PC, caching the parts they actually read on your SSD. It is not cloud gaming: your own CPU and GPU run the game, and uncached data arrives only as fast as your internet allows." />
        <TextBlock Text="Prerequisites" Style="{StaticResource H2}" />
        <ItemsControl x:Name="Deps" Margin="0,0,0,14">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,0,0,6">
                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,5,10,0" VerticalAlignment="Top" Fill="{Binding Tone, Converter={StaticResource Tone}}" />
                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding Key}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Value}" Foreground="{StaticResource Muted}" /></TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Cache location" Style="{StaticResource H2}" />
        <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Browseâ€¦" Click="Browse" Margin="8,0,0,0" />
            <TextBox x:Name="CacheBox" TextChanged="CacheChanged" />
        </DockPanel>
        <TextBlock x:Name="CacheInfo" Style="{StaticResource Caption}" Margin="0,0,0,14" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CACHE BUDGET" Style="{StaticResource Label}" />
                <ComboBox x:Name="BudgetBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="KEEP FREE FOR WINDOWS (GB)" Style="{StaticResource Label}" />
                <TextBox x:Name="ReserveBox" Text="8" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="INTERNET SPEED (Mbps)" Style="{StaticResource Label}" />
                <TextBox x:Name="MbpsBox" Text="70" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="Estimate" Style="{StaticResource Caption}" Margin="0,10,0,0" />
        <TextBlock x:Name="Status" Style="{StaticResource Caption}" Foreground="{StaticResource Danger}" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource Primary}" Content="Save and continue" Click="Ok" />
            <Button Content="Later" Click="Later" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>

