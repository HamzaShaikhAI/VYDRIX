<UserControl x:Class="Vydrix.Desktop.Views.SmartCacheView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,20">
            <!-- Phase 4: Storage Footprint & Shield Dashboard Card -->
            <Border Style="{StaticResource Card}" BorderBrush="#00E5FF" BorderThickness="1.5" Margin="0,0,0,14" Background="#0C1322">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛡️ VYDRIX STORAGE FOOTPRINT &amp; SYSTEM SHIELD" FontSize="15" FontWeight="Bold" Foreground="#00E5FF" />
                            <Border Background="#2000E5FF" CornerRadius="4" Padding="8,3" Margin="12,0,0,0">
                                <TextBlock Text="{Binding FootprintStatusSummary}" FontSize="11" Foreground="#00E5FF" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Dry-Run Preview" Command="{Binding RunGuardianDryRunCommand}" Padding="10,4" FontSize="11" Margin="0,0,8,0" />
                            <Button Content="Safe Storage Cleanup" Command="{Binding ExecuteGuardianCleanupCommand}" Padding="10,4" FontSize="11" Style="{StaticResource Primary}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Real On-Disk Storage Allocation Breakdown (10 Metrics) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Col 1: Core App & Data -->
                        <Border Background="#121828" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="INSTALLED APPLICATION" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding InstalledAppFormatted}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}" />
                                <TextBlock Text="PERSISTENT DATA" Style="{StaticResource Label}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding PersistentDataFormatted}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}" />
                            </StackPanel>
                        </Border>

                        <!-- Col 2: Logs & Staging -->
                        <Border Grid.Column="1" Background="#121828" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="LOGS &amp; DIAGNOSTICS" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding LogsAndDiagFormatted}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}" />
                                <TextBlock Text="UPDATE STAGING" Style="{StaticResource Label}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding UpdateStagingFormatted}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Text}" />
                            </StackPanel>
                        </Border>

                        <!-- Col 3: Cache Metrics -->
                        <Border Grid.Column="2" Background="#121828" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="CURRENT CACHE" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding CurrentCacheFormatted}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="CACHE PEAK" Style="{StaticResource Label}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding PeakCacheFormatted}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>

                        <!-- Col 4: Volumes (C: vs D:) -->
                        <Border Grid.Column="3" Background="#141F36" CornerRadius="6" Padding="10,8" Margin="0,0,6,0" BorderBrush="{Binding FootprintTone, Converter={StaticResource Tone}}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="TOTAL ON C: (SYSTEM)" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding TotalCFormatted}" FontWeight="Bold" FontSize="14" Foreground="{Binding FootprintTone, Converter={StaticResource Tone}}" />
                                <TextBlock Text="TOTAL ON D: (CACHE)" Style="{StaticResource Label}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding TotalDFormatted}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Success}" />
                            </StackPanel>
                        </Border>

                        <!-- Col 5: Cloud Projects on G: -->
                        <Border Grid.Column="4" Background="#121828" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="CLOUD WORKSPACE (G:)" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding CloudProjectsFormatted}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Purple}" />
                                <TextBlock Text="User games &amp; AI models" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Cache Placement Truth & Quick Actions -->
                    <Border Background="#101C30" CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                        <DockPanel LastChildFill="False">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Active Cache Target: " Foreground="{StaticResource Dim}" FontSize="12" />
                                    <TextBlock Text="{Binding CachePlacementStatusText}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Text="{Binding CacheFallbackWarningText}" Foreground="{StaticResource Warning}" FontSize="11" Margin="0,3,0,0"
                                           Visibility="{Binding CacheFallbackWarningText, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Use Secondary Drive (D:\VydrixCache)" Command="{Binding RelocateToSecondaryDriveCommand}" Padding="8,4" FontSize="11" Margin="0,0,8,0" />
                                <Button Content="Use Default C: (512 MiB Cap)" Command="{Binding RelocateToDefaultCCommand}" Padding="8,4" FontSize="11" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Storage Policy &amp; Budget" Style="{StaticResource H2}" />

                        <!-- VYDRIX 0.003.1 PHANTOM SSD: Phantom Pulse & Latency Shield Card -->
                        <Border Background="#141E38" BorderBrush="#2D3B60" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,10">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚀 PHANTOM SSD INTELLIGENCE" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" />
                                        <Border Background="#2000F0FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding PulseModeText}" FontSize="11" Foreground="#00F0FF" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="Toggle Tier A RAM Cache" Command="{Binding ToggleMemoryHotCacheCommand}" Padding="8,3" FontSize="11" />
                                </DockPanel>
                                <TextBlock Text="{Binding PulseReason}" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding BottleneckDiagnosis}" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Zero Footprint Mode Banner -->
                        <Border Background="#1A00F0FF" BorderBrush="#3300F0FF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="⚡ ZERO FOOTPRINT MODE (512 MiB Hard Cap on C:)" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="{Binding ZeroFootprintToggleText}" Command="{Binding ToggleZeroFootprintCommand}" Style="{StaticResource Primary}" Padding="10,4" />
                                </DockPanel>
                                <TextBlock Text="Demand reads only · Speculative prefetch disabled · Post-game auto-cleanup · 2-hour periodic maintenance"
                                           FontSize="11" Foreground="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        
                        <!-- Storage Policy Profiles -->
                        <TextBlock Text="STORAGE PROFILE" Style="{StaticResource Label}" Margin="0,4,0,4" />
                        <ComboBox SelectedValue="{Binding Profile, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Width="220" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <ComboBoxItem Content="ZeroFootprint" />
                            <ComboBoxItem Content="Minimal" />
                            <ComboBoxItem Content="Balanced" />
                            <ComboBoxItem Content="Custom" />
                            <ComboBoxItem Content="Disabled" />
                        </ComboBox>

                        <TextBlock Text="CACHE BUDGET (GB, all drives)" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding BudgetGb, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <ItemsControl ItemsSource="{Binding Presets}" Margin="10,0,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding StringFormat={}{0} GB}" Padding="8,4" Margin="0,0,6,0"
                                                Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="PROTECTED FREE SPACE FOR WINDOWS (GB)" Style="{StaticResource Label}" Margin="0,14,0,4" />
                        <TextBox Text="{Binding ReserveGb, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" />

                        <TextBlock Text="EVICT UNUSED DATA AFTER (DAYS)" Style="{StaticResource Label}" Margin="0,14,0,4" />
                        <TextBox Text="{Binding MaxAgeDays, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" />

                        <!-- Storage-Negative & Zero-Footprint Options -->
                        <TextBlock Text="STORAGE-NEGATIVE &amp; ZERO-FOOTPRINT OPTIONS" Style="{StaticResource Label}" Margin="0,14,0,6" />
                        <CheckBox Content="Purge all local cache on exit / unmount (Zero-Footprint Mode)"
                                  IsChecked="{Binding PurgeCacheOnExit}" Margin="0,0,0,6" />
                        <CheckBox Content="Low-space adaptive mode (auto-compress cache when volume space is low)"
                                  IsChecked="{Binding LowSpaceAdaptiveMode}" Margin="0,0,0,6" />
                        <CheckBox Content="Reclaim transient game cache automatically when game process tree exits"
                                  IsChecked="{Binding AutoReclaimOnGameExit}" Margin="0,0,0,12" />

                        <TextBlock Text="CACHE LOCATION (Supports secondary NTFS drives: D:, E:)" Style="{StaticResource Label}" Margin="0,4,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding ChooseLocationCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding CacheRoot, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Text="{Binding VolumeInfo}" Style="{StaticResource Caption}" Margin="0,6,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource Primary}" Content="Apply Policy" Command="{Binding ApplyCommand}" Margin="0,0,8,0" />
                            <Button Content="Migrate to Location…" Command="{Binding MigrateCacheLocationCommand}" Margin="0,0,8,0" />
                            <Button Content="Run safe cleanup now" ToolTip="{Binding LastCleanupInfo}" Command="{Binding RunMaintenanceCommand}" Margin="0,0,8,0" />
                            <Button Content="Clear Cache" Style="{StaticResource DangerButton}" Command="{Binding ClearCacheCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding LastCleanupInfo, StringFormat='Last cleanup: {0}'}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding SafetyAlert}" Foreground="{StaticResource Warning}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <!-- Cloud SSD Self-Test Card -->
                        <Border Background="#10172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Cloud SSD Performance Self-Test" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Content="Run Self-Test Now" Command="{Binding RunSelfTestCommand}" Padding="10,4" Style="{StaticResource Primary}" />
                                </DockPanel>
                                <TextBlock Text="{Binding SelfTestSummary}" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Storage Efficiency Engine" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding Usage}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Text="{Binding Key}" Width="190" Foreground="{StaticResource Dim}" />
                                            <TextBlock Text="{Binding Value}" Foreground="{Binding Tone, Converter={StaticResource Tone}}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Effective}" Foreground="{StaticResource Accent}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Safety &amp; Eviction Rules" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Caption}" Text="VYDRIX 2.0 strictly preserves cloud originals, saves, and dirty writes. When rclone is mounted, eviction is negotiated via rclone remote control APIs rather than unverified file deletion." />
                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Storage Reclamation Advisor -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Storage Reclamation Advisor (Opt-In Analysis)" Style="{StaticResource H2}" />
                    <TextBlock Text="Identify large game installations and assets on your PC eligible for cloud offloading without touching saves or system files." Style="{StaticResource Caption}" Margin="0,0,0,10" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Browse Folder…" Command="{Binding ChooseAdvisorFolderCommand}" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Analyze Folder" Style="{StaticResource Primary}" Command="{Binding RunStorageAdvisorScanCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding AdvisorFolder, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <Border Background="#111827" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                        <TextBlock Text="{Binding AdvisorSummary}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Pinned Files -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Pin selected file" Command="{Binding PinCommand}" />
                            <Button Content="Touch pinned files now" Command="{Binding WarmPinnedCommand}" />
                        </StackPanel>
                        <TextBlock Text="Pinned files (kept most-recently-used)" Style="{StaticResource H2}" />
                    </DockPanel>
                    <TextBlock Text="No pinned files." Style="{StaticResource Caption}" Visibility="{Binding Pinned.Count, Converter={StaticResource NotVis}}" />
                    <ItemsControl ItemsSource="{Binding Pinned}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="Unpin" Style="{StaticResource Ghost}" Padding="6,2"
                                            Command="{Binding DataContext.UnpinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Cached Files Table -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Cached files (most recently used first)" Style="{StaticResource H2}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DRIVE" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="1" Text="FILE" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="2" Text="DOWNLOADED" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="3" Text="ON DISK" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="4" Text="LOGICAL" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="5" Text="LAST ACCESS" Style="{StaticResource Label}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent" BorderThickness="0" MaxHeight="420"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="Padding" Value="0,3" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Mount}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Cached}" FontSize="12" />
                                        <ProgressBar Value="{Binding Fraction}" Maximum="1" Height="3" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Physical}" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="{Binding Logical}" FontSize="12" Foreground="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="5" Text="{Binding LastAccess}" FontSize="12" Foreground="{StaticResource Muted}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
