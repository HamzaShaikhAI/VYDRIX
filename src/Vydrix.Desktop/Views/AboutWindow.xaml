<Window x:Class="Vydrix.Desktop.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About VYDRIX" Width="440" Height="490"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Icon="pack://application:,,,/Assets/vydrix.ico">
    <Border Background="{StaticResource Surface}" Padding="28">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Large Centered VYDRIX Symbol -->
            <Border Width="112" Height="112" CornerRadius="28" Background="#080D18"
                    BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                    ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Image Source="pack://application:,,,/Assets/vydrix_256.png"
                       Width="96" Height="96"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <!-- Wordmark -->
            <TextBlock FontSize="28" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,4">
                <Run Text="VYD" /><Run Text="RIX" Foreground="{StaticResource Purple}" />
            </TextBlock>

            <!-- Tagline -->
            <TextBlock Text="CLOUD-TO-SSD ENGINE" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center"
                       Margin="0,0,0,16" />

            <!-- Version -->
            <TextBlock x:Name="VersionText" Text="Version 1.1.0" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,6" />

            <!-- Subtitle -->
            <TextBlock Text="A cloud-to-SSD engine for modern games" FontSize="13"
                       Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,0,0,18" />

            <!-- Copyright -->
            <TextBlock Text="&#x00A9; 2026 VYDRIX. All rights reserved." FontSize="11.5"
                       Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,0,0,14" />

            <!-- Open Source Licenses Link Button -->
            <Button Content="Open Source Licences" Style="{StaticResource Ghost}"
                    Click="OpenLicences_Click" HorizontalAlignment="Center" Margin="0,0,0,16" />

            <!-- Close Button -->
            <Button Content="Close" Style="{StaticResource Primary}" Width="110"
                    Click="Close_Click" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
